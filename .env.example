# Rutbhics — contoh berkas .env (LOKAL, jangan di-commit).
# Salin berkas ini menjadi .env di folder tempat kamu menjalankan `rutbhics`,
# lalu isi kuncimu. Berkas .env tidak pernah dilayani server dan sudah ada
# di .gitignore. Kunci tidak pernah masuk ke repo maupun ke browser.
LARPROUTER_API_KEY=
LARPROUTER_BASE_URL=https://larprouter.com/v1
LARPROUTER_MODEL=deepseek-v4.1-flash
# Model utama claude-opus-4-7-1m bisa dipakai setelah kreditnya cukup:
# LARPROUTER_MODEL=claude-opus-4-7-1m
