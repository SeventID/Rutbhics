# Rutbhics — contoh berkas .env (LOKAL, jangan di-commit).
# Salin berkas ini menjadi .env di folder tempat kamu menjalankan `rutbhics`,
# lalu isi kuncimu. Berkas .env tidak pernah dilayani server dan sudah ada
# di .gitignore. Kunci tidak pernah masuk ke repo maupun ke browser.
LARPROUTER_API_KEY=
LARPROUTER_BASE_URL=https://larprouter.com/v1
LARPROUTER_MODEL=deepseek-v4.1-flash
# Model utama claude-opus-4-7-1m bisa dipakai setelah kreditnya cukup:
# LARPROUTER_MODEL=claude-opus-4-7-1m

# Login Google/GitHub (OAuth) — opsional, hanya bila mau pakai tombol itu.
# Daftarkan redirect URI di provider: <alamat-server>/api/auth/google/callback
# dan <alamat-server>/api/auth/github/callback. Hapus tanda # untuk mengaktifkan.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=http://192.168.1.5:8080

# Kunci API provider AI (untuk config.json) — opsional, isi yang dipakai saja.
# Nama variabel ini yang dirujuk field apiKeyEnv di config.json.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
